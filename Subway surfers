    /* ==========================================================
       5. FAIR PROCEDURAL GENERATION (Zero Impossible Walls)
       ========================================================== */
    function initTrackChunks() {
      for (let i = 0; i < NUM_CHUNKS; i++) {
        spawnChunk(i * CHUNK_SIZE);
      }
    }

    function spawnChunk(zPos) {
      const chunkGroup = new THREE.Group();
      chunkGroup.position.z = zPos;

      // Track Bed
      const bedGeo = new THREE.BoxGeometry(11.2, 0.3, CHUNK_SIZE);
      const bedMat = new THREE.MeshStandardMaterial({ color: 0x141a26, roughness: 0.8 });
      const bed = new THREE.Mesh(bedGeo, bedMat);
      bed.position.y = -0.15;
      bed.receiveShadow = true;
      chunkGroup.add(bed);

      // Rails
      const railMat = new THREE.MeshStandardMaterial({ color: 0x99aabb, metalness: 0.8, roughness: 0.2 });
      [-4.4, -2.0, -1.2, 1.2, 2.0, 4.4].forEach(x => {
        const rail = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.16, CHUNK_SIZE), railMat);
        rail.position.set(x, 0.05, 0);
        chunkGroup.add(rail);
      });

      // Wooden Railroad Ties
      const tieMat = new THREE.MeshStandardMaterial({ color: 0x2e1e13, roughness: 0.9 });
      for (let z = -CHUNK_SIZE / 2; z < CHUNK_SIZE / 2; z += 2.5) {
        const tie = new THREE.Mesh(new THREE.BoxGeometry(10.4, 0.12, 0.8), tieMat);
        tie.position.set(0, 0.01, z);
        chunkGroup.add(tie);
      }

      // Overhead Arches
      if (Math.random() > 0.45) {
        const archMat = new THREE.MeshStandardMaterial({ color: 0x334455, metalness: 0.7 });
        const arch = new THREE.Group();
        const p1 = new THREE.Mesh(new THREE.BoxGeometry(0.4, 6.5, 0.4), archMat);
        p1.position.set(-5.6, 3.2, 0);
        const p2 = new THREE.Mesh(new THREE.BoxGeometry(0.4, 6.5, 0.4), archMat);
        p2.position.set(5.6, 3.2, 0);
        const beam = new THREE.Mesh(new THREE.BoxGeometry(11.6, 0.5, 0.5), archMat);
        beam.position.set(0, 6.2, 0);
        arch.add(p1, p2, beam);
        arch.position.z = 0;
        chunkGroup.add(arch);
      }

      // Side Buildings
      for (let side = -1; side <= 1; side += 2) {
        const bHeight = 12 + Math.random() * 20;
        const bWidth = 8 + Math.random() * 8;
        const bMat = new THREE.MeshStandardMaterial({
          color: new THREE.Color().setHSL(0.58 + Math.random() * 0.1, 0.35, 0.16),
          roughness: 0.8
        });
        const building = new THREE.Mesh(new THREE.BoxGeometry(bWidth, bHeight, 22), bMat);
        building.position.set(side * (13 + bWidth / 2), bHeight / 2 - 1, (Math.random() - 0.5) * 15);
        chunkGroup.add(building);
      }

      scene.add(chunkGroup);
      chunks.push({ group: chunkGroup, z: zPos });

      if (zPos >= 60) {
        spawnChunkEntities(zPos);
      }
    }

    function spawnChunkEntities(chunkZ) {
      const isEasyZone = distanceTraveled < 500;
      // 0-500m: Only 1 row per chunk (plenty of room). Beyond 500m: 2 rows max per chunk.
      const numRows = isEasyZone ? 1 : 2;
      const rowSpacing = CHUNK_SIZE / (numRows + 1);

      for (let r = 1; r <= numRows; r++) {
        const z = chunkZ - CHUNK_SIZE / 2 + r * rowSpacing;

        // GUARANTEED SAFE PATH: At least 1 lane is ALWAYS 100% open with coins.
        const guaranteedSafeLane = Math.floor(Math.random() * 3);
        const secondSafeLane = isEasyZone ? ((guaranteedSafeLane + 1) % 3) : -1;

        for (let lane = 0; lane < 3; lane++) {
          const laneX = LANES[lane];

          if (lane === guaranteedSafeLane || lane === secondSafeLane) {
            // Coins in safe open lane
            spawnCoinRow(laneX, z, Math.random() > 0.5 ? 'arc' : 'straight');
          } else {
            // Spawn single obstacle
            const obsRoll = Math.random();
            if (obsRoll < 0.45) {
              createTrain(laneX, z, !isEasyZone && Math.random() > 0.7);
            } else if (obsRoll < 0.75) {
              createLowHurdle(laneX, z);
            } else {
              createHighBarrier(laneX, z);
            }
          }
        }
      }
    }

    function createTrain(x, z, isMoving) {
      const trainGroup = new THREE.Group();
      const length = 15;
      const height = 3.5;
      const width = 2.5;

      const bodyMat = new THREE.MeshStandardMaterial({
        color: isMoving ? 0xcc2936 : 0x2266aa,
        roughness: 0.3,
        metalness: 0.6
      });
      const body = new THREE.Mesh(new THREE.BoxGeometry(width, height, length), bodyMat);
      body.position.y = height / 2;
      body.castShadow = true;
      body.receiveShadow = true;
      trainGroup.add(body);

      // Windows and headlights
      const windowMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
      const win = new THREE.Mesh(new THREE.BoxGeometry(width * 0.8, 0.85, 0.1), windowMat);
      win.position.set(0, height * 0.7, -length / 2 - 0.05);
      trainGroup.add(win);

      const lightMat = new THREE.MeshBasicMaterial({ color: 0xffe600 });
      [-0.8, 0.8].forEach(lx => {
        const light = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.18, 0.1, 12), lightMat);
        light.rotation.x = Math.PI / 2;
        light.position.set(lx, 0.85, -length / 2 - 0.06);
        trainGroup.add(light);
      });

      trainGroup.position.set(x, 0, z);
      scene.add(trainGroup);

      obstacles.push({
        type: 'TRAIN',
        group: trainGroup,
        width: width,
        height: height,
        length: length,
        moving: isMoving,
        speed: isMoving ? 7 : 0
      });
    }

    function createLowHurdle(x, z) {
      const group = new THREE.Group();
      const barMat = new THREE.MeshStandardMaterial({ color: 0xffaa00, roughness: 0.4 });
      const standMat = new THREE.MeshStandardMaterial({ color: 0x333333 });

      const bar = new THREE.Mesh(new THREE.BoxGeometry(2.7, 0.3, 0.25), barMat);
      bar.position.y = 0.8;
      bar.castShadow = true;
      group.add(bar);

      [-1.2, 1.2].forEach(sx => {
        const stand = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.9, 0.18), standMat);
        stand.position.set(sx, 0.45, 0);
        group.add(stand);
      });

      group.position.set(x, 0, z);
      scene.add(group);

      obstacles.push({
        type: 'LOW_HURDLE',
        group: group,
        width: 2.7,
        height: 0.95,
        length: 0.6
      });
    }

    function createHighBarrier(x, z) {
      const group = new THREE.Group();
      const frameMat = new THREE.MeshStandardMaterial({ color: 0xff3344, roughness: 0.3 });
      const signMat = new THREE.MeshStandardMaterial({ color: 0xffff00 });

      const sign = new THREE.Mesh(new THREE.BoxGeometry(2.7, 1.25, 0.25), signMat);
      sign.position.y = 2.4;
      sign.castShadow = true;
      group.add(sign);

      [-1.25, 1.25].forEach(px => {
        const post = new THREE.Mesh(new THREE.BoxGeometry(0.2, 3.2, 0.2), frameMat);
        post.position.set(px, 1.6, 0);
        group.add(post);
      });

      group.position.set(x, 0, z);
      scene.add(group);

      obstacles.push({
        type: 'HIGH_BARRIER',
        group: group,
        width: 2.7,
        height: 3.2,
        clearance: 1.35,
        length: 0.6
      });
    }

    function spawnCoinRow(x, centerZ, style) {
      const count = 5;
      const coinMat = new THREE.MeshStandardMaterial({
        color: 0xffd700,
        metalness: 0.9,
        roughness: 0.2,
        emissive: 0xcc9900,
        emissiveIntensity: 0.4
      });
      const coinGeo = new THREE.CylinderGeometry(0.38, 0.38, 0.12, 14);
      coinGeo.rotateZ(Math.PI / 2);

      for (let i = 0; i < count; i++) {
        const z = centerZ - (count * 2) / 2 + i * 2.2;
        let y = 1.0;

        if (style === 'arc') {
          const t = i / (count - 1);
          y = 1.0 + Math.sin(t * Math.PI) * 2.3;
        }

        const coin = new THREE.Mesh(coinGeo, coinMat);
        coin.position.set(x, y, z);
        scene.add(coin);
        coins.push(coin);
      }
    }

    function spawnParticles(x, y, z, colorHex, count = 12) {
      const pMat = new THREE.MeshBasicMaterial({ color: colorHex });
      const pGeo = new THREE.BoxGeometry(0.18, 0.18, 0.18);

      for (let i = 0; i < count; i++) {
        const p = new THREE.Mesh(pGeo, pMat);
        p.position.set(x, y, z);
        scene.add(p);
        particles.push({
          mesh: p,
          vx: (Math.random() - 0.5) * 10,
          vy: Math.random() * 8 + 2,
          vz: (Math.random() - 0.5) * 10,
          life: 0.55
        });
      }
    }

    /* ==========================================================
       6. EXACT DIRECTIONAL CONTROLS (Left = Left, Right = Right)
       ========================================================== */
    // Lane 0 = Left (LANES[0] = +3.25)
    // Lane 1 = Center (LANES[1] = 0)
    // Lane 2 = Right (LANES[2] = -3.25)

    function moveLeft() {
      if (currentState !== GAME_STATE.PLAYING) return;
      if (currentLane > 0) {
        currentLane--;
        targetX = LANES[currentLane];
        sound.playClick();
      }
    }

    function moveRight() {
      if (currentState !== GAME_STATE.PLAYING) return;
      if (currentLane < 2) {
        currentLane++;
        targetX = LANES[currentLane];
        sound.playClick();
      }
    }

    function triggerJump() {
      if (currentState !== GAME_STATE.PLAYING) return;
      if (!isJumping) {
        isJumping = true;
        playerVY = JUMP_VELOCITY;
        if (isSliding) isSliding = false;
        sound.playJump();
      }
    }

    function triggerSlide() {
      if (currentState !== GAME_STATE.PLAYING) return;
      if (!isSliding) {
        isSliding = true;
        slideTimer = SLIDE_TIME;
        if (isJumping) {
          playerVY = -22;
        }
        sound.playSlide();
      }
    }

    function triggerSkateboard() {
      if (currentState !== GAME_STATE.PLAYING) return;
      if (skateboardActive) return;

      if (skateboardInventory <= 0) {
        showToast("No skateboards left! (+1 unlocks at 400m)");
        return;
      }

      skateboardInventory--;
      skateboardActive = true;
      skateboardTimeLeft = SKATEBOARD_DURATION;
      skateboardMesh.visible = true;
      sound.playSkateboard();
      spawnParticles(playerMeshGroup.position.x, 0.5, playerMeshGroup.position.z, 0x00ffff, 20);
      showToast("🛹 SKATEBOARD ACTIVATED!");
      updateHUDUI();
    }

    function showToast(text) {
      const toast = document.getElementById('toast');
      toast.innerText = text;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2200);
    }

    /* ==========================================================
       7. INPUT HANDLING (Keys, Gestures & Redesigned D-Pad)
       ========================================================== */
    function setupInputs() {
      // 1. Keyboard
      window.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        switch (e.code) {
          case 'ArrowLeft':
          case 'KeyA':
            moveLeft();
            break;
          case 'ArrowRight':
          case 'KeyD':
            moveRight();
            break;
          case 'ArrowUp':
          case 'KeyW':
          case 'Space':
            triggerJump();
            break;
          case 'ArrowDown':
          case 'KeyS':
            triggerSlide();
            break;
          case 'KeyE':
            triggerSkateboard();
            break;
          case 'KeyP':
          case 'Escape':
            togglePause();
            break;
        }
      });

      // 2. Desktop Double-Click
      window.addEventListener('dblclick', (e) => {
        if (e.target.tagName === 'BUTTON') return;
        triggerSkateboard();
      });

      // 3. Touch Gestures (Swipe & Double-Tap)
      let touchStartX = 0;
      let touchStartY = 0;
      let touchStartTime = 0;

      window.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          touchStartTime = performance.now();
        }
      }, { passive: true });

      window.addEventListener('touchend', (e) => {
        if (e.changedTouches.length === 1) {
          const dx = e.changedTouches[0].clientX - touchStartX;
          const dy = e.changedTouches[0].clientY - touchStartY;
          const dt = performance.now() - touchStartTime;

          const absX = Math.abs(dx);
          const absY = Math.abs(dy);

          if (absX > 32 || absY > 32) {
            // Swipe: Left dx < 0 -> Left, Right dx > 0 -> Right
            if (absX > absY) {
              if (dx < 0) moveLeft();
              else moveRight();
            } else {
              if (dy < 0) triggerJump();
              else triggerSlide();
            }
          } else if (dt < 280) {
            const now = performance.now();
            if (now - lastTapTime < 320) {
              triggerSkateboard();
              lastTapTime = 0;
            } else {
              lastTapTime = now;
            }
          }
        }
      }, { passive: true });

      // 4. Redesigned D-Pad Cluster
      const bindBtn = (id, action) => {
        const el = document.getElementById(id);
        el.addEventListener('pointerdown', (e) => {
          e.preventDefault();
          e.stopPropagation();
          action();
        });
      };

      bindBtn('btn-jump', triggerJump); // Middle Top
      bindBtn('btn-down', triggerSlide); // Middle Bottom
      bindBtn('btn-left', moveLeft);     // Left Side
      bindBtn('btn-right', moveRight);   // Right Side
      bindBtn('btn-skate-action', triggerSkateboard); // Beside them

      // 5. System UI Buttons
      document.getElementById('btn-pause').addEventListener('click', togglePause);
      document.getElementById('btn-resume').addEventListener('click', resumeGame);
      document.getElementById('btn-restart-pause').addEventListener('click', startNewGame);

      document.getElementById('btn-audio').addEventListener('click', () => {
        sound.muted = !sound.muted;
        document.getElementById('btn-audio').innerText = sound.muted ? '🔇' : '🔊';
      });

      document.getElementById('btn-play').addEventListener('click', () => {
        sound.init();
        sound.playClick();
        beginCountdown();
      });

      document.getElementById('btn-playagain').addEventListener('click', () => {
        sound.playClick();
        document.getElementById('gameover-modal').style.display = 'none';
        startNewGame();
      });
    }

    /* ==========================================================
       8. GAME STATE FLOW
       ========================================================== */
    function beginCountdown() {
      document.getElementById('start-screen').style.display = 'none';
      currentState = GAME_STATE.COUNTDOWN;

      const overlay = document.getElementById('countdown-overlay');
      const text = document.getElementById('countdown-text');
      overlay.style.display = 'flex';

      let count = 3;
      text.innerText = count;
      text.className = 'pop';

      const interval = setInterval(() => {
        count--;
        if (count > 0) {
          text.className = '';
          setTimeout(() => {
            text.innerText = count;
            text.className = 'pop';
            sound.playJump();
          }, 40);
        } else if (count === 0) {
          text.className = '';
          setTimeout(() => {
            text.innerText = 'GO!';
            text.className = 'pop';
            sound.playUnlock();
          }, 40);
        } else {
          clearInterval(interval);
          overlay.style.display = 'none';
          startGameplay();
        }
      }, 700);
    }

    function startGameplay() {
      currentState = GAME_STATE.PLAYING;
      document.getElementById('hud').style.display = 'flex';
      lastTime = performance.now();
    }

    function togglePause() {
      if (currentState === GAME_STATE.PLAYING) {
        currentState = GAME_STATE.PAUSED;
        document.getElementById('pause-modal').style.display = 'flex';
        sound.playClick();
      }
    }

    function resumeGame() {
      if (currentState === GAME_STATE.PAUSED) {
        document.getElementById('pause-modal').style.display = 'none';
        currentState = GAME_STATE.PLAYING;
        lastTime = performance.now();
        sound.playClick();
      }
    }

    function triggerGameOver() {
      if (currentState === GAME_STATE.GAME_OVER) return;
      currentState = GAME_STATE.GAME_OVER;
      cameraShake = 0.75;
      sound.playCrash();

      const finalScore = Math.floor(score);
      if (finalScore > bestScore) {
        bestScore = finalScore;
        localStorage.setItem('track_escape_best_score', bestScore);
      }

      outlawMeshGroup.position.z = playerMeshGroup.position.z - 0.4;
      outlawMeshGroup.position.x = playerMeshGroup.position.x;

      setTimeout(() => {
        document.getElementById('res-score').innerText = finalScore;
        document.getElementById('res-best').innerText = bestScore;
        document.getElementById('res-coins').innerText = coinsCollected;
        document.getElementById('res-distance').innerText = `${Math.floor(distanceTraveled)} m`;
        document.getElementById('gameover-modal').style.display = 'flex';
      }, 1000);
    }

    function startNewGame() {
      obstacles.forEach(o => scene.remove(o.group));
      obstacles = [];
      coins.forEach(c => scene.remove(c));
      coins = [];
      particles.forEach(p => scene.remove(p.mesh));
      particles = [];

      chunks.forEach(c => scene.remove(c.group));
      chunks = [];
      initTrackChunks();

      score = 0;
      coinsCollected = 0;
      distanceTraveled = 0;
      currentSpeed = 19;
      currentLane = 1;
      targetX = LANES[1];
      playerMeshGroup.position.set(0, 0, 0);
      playerY = 0;
      playerVY = 0;
      isJumping = false;
      isSliding = false;
      slideTimer = 0;

      skateboardInventory = 1;
      reward400Unlocked = false;
      skateboardActive = false;
      skateboardTimeLeft = 0;
      skateboardMesh.visible = false;
      shieldInvincibleTimer = 0;

      outlawMeshGroup.position.set(0, 0, -5.5);

      updateHUDUI();
      document.getElementById('pause-modal').style.display = 'none';
      document.getElementById('gameover-modal').style.display = 'none';

      beginCountdown();
    }

    /* ==========================================================
       9. GAME LOOP & ANIMATION UPDATE
       ========================================================== */
    function update(dt) {
      if (currentState !== GAME_STATE.PLAYING && currentState !== GAME_STATE.GAME_OVER) {
        animateLimbs(performance.now() * 0.005, false);
        return;
      }

      const timeSec = performance.now() * 0.001;

      if (currentState === GAME_STATE.PLAYING) {
        distanceTraveled += currentSpeed * dt * 0.5;
        score += currentSpeed * dt * 1.5;

        // Progressive Speed Scaling
        if (distanceTraveled < 500) {
          currentSpeed = 19 + (distanceTraveled / 500) * 4;
        } else {
          currentSpeed = 23 + Math.min(27, Math.pow((distanceTraveled - 500) / 100, 0.7) * 4.5);
        }

        // 400m Skateboard Reward
        if (distanceTraveled >= 400 && !reward400Unlocked) {
          reward400Unlocked = true;
          skateboardInventory++;
          sound.playUnlock();
          showToast("🎉 400m REACHED! +1 SKATEBOARD REWARD!");
          updateHUDUI();
        }

        // Skateboard Duration
        if (skateboardActive) {
          skateboardTimeLeft -= dt;
          if (skateboardTimeLeft <= 0) {
            skateboardActive = false;
            skateboardMesh.visible = false;
            showToast("Skateboard expired");
          }
          updateHUDUI();
        }

        if (shieldInvincibleTimer > 0) {
          shieldInvincibleTimer -= dt;
          playerMeshGroup.visible = Math.floor(timeSec * 20) % 2 === 0;
        } else {
          playerMeshGroup.visible = true;
        }
      }

      // Smooth horizontal lane interpolation
      playerMeshGroup.position.x += (targetX - playerMeshGroup.position.x) * 15 * dt;
      playerMeshGroup.rotation.z = -(playerMeshGroup.position.x - targetX) * 0.12;

      // Jump & Gravity
      if (isJumping) {
        playerY += playerVY * dt;
        playerVY += GRAVITY * dt;
        if (playerY <= 0) {
          playerY = 0;
          playerVY = 0;
          isJumping = false;
        }
      }

      // Slide Timer
      if (isSliding) {
        slideTimer -= dt;
        if (slideTimer <= 0) {
          isSliding = false;
        }
      }

      playerMeshGroup.position.y = playerY;
      if (isSliding) {
        playerMeshGroup.scale.set(1, 0.45, 1.1);
      } else {
        playerMeshGroup.scale.set(1, 1, 1);
      }

      // Track Movement
      const forwardDelta = currentSpeed * dt;
      if (currentState === GAME_STATE.PLAYING) {
        chunks.forEach(chunk => {
          chunk.group.position.z -= forwardDelta;
        });

        if (chunks[0].group.position.z < -CHUNK_SIZE) {
          const oldChunk = chunks.shift();
          const newestZ = chunks[chunks.length - 1].group.position.z + CHUNK_SIZE;
          oldChunk.group.position.z = newestZ;
          chunks.push(oldChunk);
          spawnChunkEntities(newestZ);
        }

        // Obstacles & Collision Check
        for (let i = obstacles.length - 1; i >= 0; i--) {
          const obs = obstacles[i];
          obs.group.position.z -= forwardDelta + (obs.speed || 0) * dt;

          if (shieldInvincibleTimer <= 0 && checkCollision(obs)) {
            if (skateboardActive) {
              // Skateboard Shield Absorbs Crash
              skateboardActive = false;
              skateboardMesh.visible = false;
              shieldInvincibleTimer = 1.8;
              sound.playCrash();
              spawnParticles(playerMeshGroup.position.x, 1, 0, 0xff0066, 25);
              showToast("🛹 SKATEBOARD SAVED YOU!");
              updateHUDUI();
              obs.group.position.y = -20;
            } else {
              triggerGameOver();
              break;
            }
          }

          if (obs.group.position.z < -25) {
            scene.remove(obs.group);
            obstacles.splice(i, 1);
          }
        }

        // Coins Check
        for (let i = coins.length - 1; i >= 0; i--) {
          const coin = coins[i];
          coin.position.z -= forwardDelta;
          coin.rotation.y += 3.5 * dt;

          const dx = Math.abs(coin.position.x - playerMeshGroup.position.x);
          const dy = Math.abs(coin.position.y - (playerY + 1));
          const dz = Math.abs(coin.position.z - playerMeshGroup.position.z);

          if (dx < 0.9 && dy < 1.3 && dz < 1.2) {
            coinsCollected++;
            score += 50;
            sound.playCoin();
            spawnParticles(coin.position.x, coin.position.y, coin.position.z, 0xffd700, 8);
            scene.remove(coin);
            coins.splice(i, 1);
            continue;
          }

          if (coin.position.z < -20) {
            scene.remove(coin);
            coins.splice(i, 1);
          }
        }
      }

      // Outlaw Bandit Follow
      if (currentState === GAME_STATE.PLAYING) {
        outlawMeshGroup.position.x += (playerMeshGroup.position.x - outlawMeshGroup.position.x) * 6 * dt;
        outlawMeshGroup.position.z = -5.5;
        outlawMeshGroup.position.y = playerY * 0.4;
      }

      animateLimbs(timeSec * currentSpeed * 0.45, isSliding);

      // Particles
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.mesh.position.x += p.vx * dt;
        p.mesh.position.y += p.vy * dt;
        p.mesh.position.z += p.vz * dt;
        p.vy -= 24 * dt;
        p.life -= dt;
        if (p.life <= 0) {
          scene.remove(p.mesh);
          particles.splice(i, 1);
        }
      }

      // Camera Follow & Shake
      if (cameraShake > 0) {
        camera.position.x = (Math.random() - 0.5) * cameraShake;
        camera.position.y = 5.0 + (Math.random() - 0.5) * cameraShake;
        cameraShake -= dt * 1.5;
      } else {
        camera.position.x = -playerMeshGroup.position.x * 0.35;
        camera.position.y = 5.0 + (playerY * 0.3);
      }

      updateHUDUI();
    }

    function animateLimbs(t, sliding) {
      if (sliding) {
        playerLimbs.leftArm.rotation.x = -1.2;
        playerLimbs.rightArm.rotation.x = -1.2;
        playerLimbs.leftLeg.rotation.x = 1.2;
        playerLimbs.rightLeg.rotation.x = 1.2;
        return;
      }

      if (skateboardActive) {
        playerLimbs.leftArm.rotation.set(0.4, 0.4, 0.8);
        playerLimbs.rightArm.rotation.set(-0.4, -0.4, -0.8);
        playerLimbs.leftLeg.rotation.set(0.3, 0.2, 0);
        playerLimbs.rightLeg.rotation.set(-0.3, -0.2, 0);
        playerMeshGroup.rotation.y = -0.5;
      } else {
        playerMeshGroup.rotation.y = 0;
        const swing = Math.sin(t) * 0.85;
        playerLimbs.leftArm.rotation.x = swing;
        playerLimbs.rightArm.rotation.x = -swing;
        playerLimbs.leftLeg.rotation.x = -swing;
        playerLimbs.rightLeg.rotation.x = swing;
      }

      const outlawSwing = Math.sin(t * 1.1) * 0.95;
      outlawLimbs.leftArm.rotation.x = outlawSwing;
      outlawLimbs.rightArm.rotation.x = -outlawSwing;
      outlawLimbs.leftLeg.rotation.x = -outlawSwing;
      outlawLimbs.rightLeg.rotation.x = outlawSwing;
    }

    function checkCollision(obs) {
      const pX = playerMeshGroup.position.x;
      const pY = playerY;
      const pZ = 0;

      const oX = obs.group.position.x;
      const oZ = obs.group.position.z;

      const halfW = (obs.width || 2.5) / 2 + 0.32;
      const halfL = (obs.length || 1.0) / 2 + 0.32;

      if (Math.abs(pX - oX) < halfW && Math.abs(pZ - oZ) < halfL) {
        if (obs.type === 'LOW_HURDLE') {
          if (pY < 0.82) return true;
        } else if (obs.type === 'HIGH_BARRIER') {
          if (!isSliding) return true;
        } else {
          if (pY < (obs.height || 3.5) * 0.9) return true;
        }
      }
      return false;
    }

    function updateHUDUI() {
      document.getElementById('hud-best-score').innerText = bestScore;
      document.getElementById('hud-score').innerText = Math.floor(score).toString().padStart(6, '0');
      document.getElementById('hud-coins').innerText = coinsCollected.toString().padStart(4, '0');
      document.getElementById('hud-distance').innerText = `${Math.floor(distanceTraveled)} m`;

      const skateBtn = document.getElementById('btn-skate-action');
      const skateBadge = document.getElementById('skate-badge');

      if (skateboardActive) {
        skateBtn.className = 'skate-btn active';
        skateBadge.innerText = `${Math.ceil(skateboardTimeLeft)}s`;
      } else {
        skateBtn.className = 'skate-btn';
        skateBadge.innerText = `x${skateboardInventory}`;
      }
    }

    function animate(now) {
      requestAnimationFrame(animate);
      const dt = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;

      update(dt);
      renderer.render(scene, camera);
    }

    /* ==========================================================
       10. START
       ========================================================== */
    window.addEventListener('DOMContentLoaded', () => {
      init3D();
      setupInputs();
      lastTime = performance.now();
      requestAnimationFrame(animate);
    });
  </script>
